{
    "name": "saanich-peninsula-flora",
    "description": "Saanich Peninsula Flora Storymapping in R",
    "version": "1.0.0",
    "author": "IMERSS, Transition Salt Spring",
    "scripts": {
        "lint": "fluid-lint-all",
        "story": "node src/js/storyBuild.js content/story viz_data static/story",
        "vendor": "fluid-copyout static/story/index-dev.html",
        "hydrate": "fluid-hydrate docs/story/index.html -o docs/story/index.html",
        "theme": "node src/js/themeAssets.js",
        "site": "node src/js/adoptPublished.js docs static && hugo --cleanDestinationDir",
        "build": "npm run story && npm run vendor && npm run site && npm run hydrate"
    },
    "dependencies": {
        "@imerss/inat-components": "3.0.0",
        "imerss-bioinfo": "1.20.0",
        "infusion-6": "6.2.4",
        "js-yaml": "4.1.1",
        "json5": "2.2.3",
        "linkedom": "0.14.25"
    },
    "devDependencies": {
        "antlr4": "4.13.2",
        "eslint": "8.39.0",
        "eslint-config-fluid": "2.1.1",
        "fluid-lint-all": "1.2.9",
        "fs-extra": "11.1.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/IMERSS/saanich-peninsula-flora"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "BSD-3-Clause"
}
